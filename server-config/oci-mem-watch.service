[Unit]
Description=OCI host memory watch (peak/swap → obs-notify on level change)
Documentation=https://github.com/yushin0319/n8n-server (#567 Phase 4)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/bin/check-host-mem.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30s
