        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"filter\": {\"or\": [{\"property\": \"ステータス\", \"status\": {\"equals\": \"未着手\"}}, {\"property\": \"ステータス\", \"status\": {\"equals\": \"進行中\"}}]}, \"sorts\": [{\"property\": \"ステータス\", \"direction\": \"ascending\"}]}",
