    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst name = input.name || '新しいタスク';\nconst parentId = input.parent_id || null;\nconst coverUrl = input.cover_url || null;\nconst content = input.content || null;\n\nconst body = {\n  parent: { database_id: '2a02570f-e49f-802b-a67c-fe4c230a5699' },\n  properties: {\n    '': { title: [{ text: { content: name } }] }\n  }\n};\n\nif (parentId) {\n  body.properties['親タスク'] = { relation: [{ id: parentId }] };\n}\n\nif (coverUrl) {\n  body.cover = { type: 'external', external: { url: coverUrl } };\n}\n\nif (content) {\n  const lines = content.split('\n');\n  body.children = lines.map(line => ({\n    object: 'block',\n    type: 'paragraph',\n    paragraph: {\n      rich_text: [{ type: 'text', text: { content: line } }]\n    }\n  }));\n}\n\nreturn [{ json: { requestBody: JSON.stringify(body) } }];"
      },
