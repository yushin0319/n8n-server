    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst pageId = input.page_id;\nif (!pageId) {\n  throw new Error('page_id is required for update action');\n}\n\nconst body = { properties: {} };\n\nif (input.name !== undefined) {\n  body.properties[''] = { title: [{ text: { content: input.name } }] };\n}\n\nif (input.status !== undefined) {\n  body.properties['ステータス'] = { status: { name: input.status } };\n}\n\nif (input.parent_id !== undefined) {\n  if (input.parent_id) {\n    body.properties['親タスク'] = { relation: [{ id: input.parent_id }] };\n  } else {\n    body.properties['親タスク'] = { relation: [] };\n  }\n}\n\nconst result = { pageId, requestBody: JSON.stringify(body) };\n\nif (input.cover_url) {\n  const bodyWithCover = JSON.parse(result.requestBody);\n  bodyWithCover.cover = { type: 'external', external: { url: input.cover_url } };\n  result.requestBody = JSON.stringify(bodyWithCover);\n}\n\nreturn [{ json: result }];"
      },
