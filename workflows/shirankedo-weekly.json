      },
      "id": "0e8f0490-61ff-4fe2-bb78-0ff3124648b9",
      "name": "GeminiWeeklyReport",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
