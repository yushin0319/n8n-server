              "id": "3b12520c-9458-47a8-ba52-0d57966cab13",
              "leftValue": "={{ $json.hasArticles }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
