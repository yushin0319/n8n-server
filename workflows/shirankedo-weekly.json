        "jsonBody": "={{ $json.requestBody }}",
        "options": {}
      },
      "id": "1c39771c-d3c3-444f-992b-960b23ada569",
      "name": "PostRepoStats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
