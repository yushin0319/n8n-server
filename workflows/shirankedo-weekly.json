    {
      "parameters": {
        "method": "GET",
        "url": "https://shirankedo.y-fudo.workers.dev/api/ingest/tracking-repos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "id": "11ec03ea-11e3-4e9c-8ef8-d16dd88eb4fe",
      "name": "FetchTrackingRepos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CdkfLkdZEMFfnx8h",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// tracking-reposからstar取得用GraphQLバッチを構築（200リポ/バッチ）\nconst repos = $input.first().json.data || [];\nif (!repos.length) return [{ json: { batches: [], count: 0 } }];\n\nconst batchSize = 200;\nconst batches = [];\nfor (let i = 0; i < repos.length; i += batchSize) {\n  const batch = repos.slice(i, i + batchSize);\n  const parts = batch.map((r, idx) => {\n    const [owner, name] = r.repo.split('/');\n    return `r${i+idx}: repository(owner: \"${owner}\", name: \"${name}\") { nameWithOwner stargazerCount }`;\n  });\n  batches.push({ json: { query: `{${parts.join(' ')}}`, batchIndex: batches.length } });\n}\nreturn batches;"
      },
      "id": "5d6b0d9f-fb1c-49c3-aa4f-d444b7762838",
      "name": "BuildStarBatches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "292c8ca7-4669-4eb4-8043-acb0f4d6d340",
      "name": "SplitStarBatches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        960,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/graphql",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: $json.query }) }}",
        "options": {}
      },
      "id": "26d0f6e1-7571-49f2-9dc6-12f65bb16b5d",
      "name": "FetchStarBatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "githubApi": {
          "id": "GMg4fnokNoF4q4MU",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 各バッチのGraphQL結果からstar数をstaticDataに蓄積\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.stars) staticData.stars = [];\nconst data = $input.first().json.data || $input.first().json || {};\nfor (const key of Object.keys(data)) {\n  const repo = data[key];\n  if (!repo || !repo.nameWithOwner) continue;\n  staticData.stars.push({ repo: repo.nameWithOwner, stars: repo.stargazerCount });\n}\nreturn $input.all();"
      },
      "id": "9f715955-3f20-463b-8d83-ff6fedc7066c",
      "name": "AccumulateStars",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// staticDataからstar結果を取り出してPOST用に整形\nconst staticData = $getWorkflowStaticData('global');\nconst stars = staticData.stars || [];\nstaticData.stars = [];\n\n// 50件チャンクに分割\nconst chunks = [];\nfor (let i = 0; i < stars.length; i += 50) {\n  chunks.push(stars.slice(i, i + 50));\n}\nif (chunks.length === 0) chunks.push([]);\n\nreturn chunks.map((chunk, idx) => ({\n  json: {\n    requestBody: JSON.stringify(chunk),\n    count: chunk.length,\n    chunkIndex: idx,\n    totalChunks: chunks.length,\n    totalStars: stars.length,\n  }\n}));"
      },
      "id": "ea7d718d-79b5-4341-a276-8c18f2f16c6f",
      "name": "ParseStars",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        500
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b4488b84-3bae-4ca0-940d-a8662b674efa",
      "name": "SplitStarChunks",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1440,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://shirankedo.y-fudo.workers.dev/api/ingest/repo-stats",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}",
        "options": {}
      },
      "id": "c49f9152-06a4-46ab-ba3f-c8b2481ee20a",
      "name": "PostRepoStats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CdkfLkdZEMFfnx8h",
          "name": "Header Auth account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// POST結果をstaticDataに蓄積\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.postResults) staticData.postResults = { total: 0, errors: 0 };\nconst res = $input.first().json;\nif (res && res.ok) {\n  staticData.postResults.total += (res.upserted || 0);\n} else {\n  staticData.postResults.errors += 1;\n}\nreturn $input.all();"
      },
      "id": "92748118-fd74-46ee-82d8-f8270ad8ba1c",
      "name": "AccumulatePostResults",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
