      "id": "12723e45-0b15-4d5a-9a40-b0c98420e6ea",
      "name": "GeminiWeeklyReport",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        700
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "rlflsmwVLnPi2SAN",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Geminiレスポンスからレポートテキストを抽出\nconst resp = $input.first().json;\nconst reportContent = resp.candidates?.[0]?.content?.parts?.[0]?.text || '';\nif (!reportContent) {\n  return [{ json: { requestBody: JSON.stringify({ content: '生成失敗' }), reportContent: '' } }];\n}\nreturn [{ json: {\n  requestBody: JSON.stringify({ content: reportContent }),\n  reportContent\n} }];"
      },
      "id": "b0b40700-50a2-443c-bfb3-9d1f41582595",
      "name": "FormatWeeklyReport",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
