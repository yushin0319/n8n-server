        1920,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "// staticDataからPOST結果を読み出し\nconst staticData = $getWorkflowStaticData('global');\nconst results = staticData.postResults || { total: 0, errors: 0 };\nstaticData.postResults = null;\nreturn [{ json: results }];"
      },
      "id": "afee432c-83a1-49f3-90d4-a79f771be775",
      "name": "ParsePostResults",
