      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// POST結果をstaticDataに蓄積\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.postResults) staticData.postResults = { total: 0, errors: 0 };\nconst res = $input.first().json;\nif (res && res.ok) {\n  staticData.postResults.total += (res.inserted || 0);\n} else {\n  staticData.postResults.errors += 1;\n}\nreturn $input.all();"
      },
      "id": "88218014-70d3-4a7a-99dd-032e65e13352",
      "name": "AccumulatePostResults",
      "type": "n8n-nodes-base.code",
