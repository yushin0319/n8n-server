    },
    {
      "parameters": {
        "jsCode": "// 直近7日の記事からGemini週次レポート用プロンプトを構築\nconst articles = $input.first().json.data || [];\nif (!articles.length) {\n  return [{ json: { prompt: '', hasArticles: false, count: 0 } }];\n}\n\nconst articleList = articles.map((a, i) =>\n  `${i+1}. [${a.source}] ${a.title}\\n   要約: ${a.summary}\\n   タグ: ${a.tags}`\n).join('\\n\\n');\n\nconst prompt = `あなたはテック系ニュースの週次レポートライターです。ギャル口調（～じゃん、～っしょ、マジで、ガチで等）で書いてください。\n\n以下の今週の記事一覧から、週次レポートを作成してください。\n\n## フォーマット\n- 500〜800文字程度\n- 今週の大きなトレンドや注目ポイントを3〜5個にまとめる\n- 各トレンドに関連する記事を引用\n- 最後に一言まとめ\n\n## 今週の記事（${articles.length}件）\n${articleList}`;\n\nreturn [{ json: { prompt, hasArticles: true, count: articles.length } }];"
      },
      "id": "e42d0850-dd49-4beb-8c82-1406fc6052e3",
      "name": "PrepareWeeklyPrompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        800
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "bc14da2d-5e8a-4309-acf3-f96626af53b8",
              "leftValue": "={{ $json.hasArticles }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "89ab94f2-3c49-46da-9502-2001623bd56a",
      "name": "HasArticlesForReport",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        800
