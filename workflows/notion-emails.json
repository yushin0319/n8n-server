    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/2ff2570f-e49f-8119-aaaf-f688605e5aa3/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}"
      },
      "id": "b-search-query",
      "name": "SearchQuery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        120
      ],
      "credentials": {
        "notionApi": {
          "id": "StdChbKZz3co4jDO",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = $input.first().json.results || [];\nconst emails = results.map(page => {\n  const subject = (page.properties['件名']?.title || []).map(t => t.plain_text).join('') || '(無題)';\n  const from = (page.properties['差出人']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  const date = page.properties['日時']?.date?.start || '';\n  const importance = page.properties['重要度']?.select?.name || '未設定';\n  const snippet = (page.properties['スニペット']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  const status = page.properties['ステータス']?.select?.name || '未設定';\n  const reason = (page.properties['理由']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  return { id: page.id, subject, from, date, importance, snippet, status, reason, url: page.url };\n});\nreturn [{ json: { action: 'search', count: emails.length, emails } }];"
      },
