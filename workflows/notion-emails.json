    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst pageId = input.page_id;\nif (!pageId) throw new Error('page_id is required');\nconst body = { properties: {} };\nif (input.importance !== undefined) {\n  body.properties['重要度'] = { select: { name: input.importance } };\n}\nif (input.reason !== undefined) {\n  body.properties['理由'] = { rich_text: [{ text: { content: input.reason } }] };\n}\nif (input.status !== undefined) {\n  body.properties['ステータス'] = { select: { name: input.status } };\n}\nreturn [{ json: { pageId, requestBody: JSON.stringify(body) } }];"
      },
