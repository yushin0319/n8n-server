        "jsCode": "const ids = $input.first().json.allPageIds || [];\nif (ids.length === 0) return [];\nconst updateBody = JSON.stringify({ properties: { 'ステータス': { select: { name: '既読' } } } });\nreturn ids.map(pageId => ({ json: { pageId, requestBody: updateBody } }));"
      },
