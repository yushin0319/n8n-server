      "credentials": {
        "notionApi": {
          "id": "StdChbKZz3co4jDO",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first().json.results || [];\nconst emails = results.map(page => {\n  const subject = (page.properties['件名']?.title || []).map(t => t.plain_text).join('') || '(無題)';\n  const from = (page.properties['差出人']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  const date = page.properties['日時']?.date?.start || '';\n  const importance = page.properties['重要度']?.select?.name || '未設定';\n  const snippet = (page.properties['スニペット']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  const status = page.properties['ステータス']?.select?.name || '未設定';\n  const reason = (page.properties['理由']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  return { id: page.id, subject, from, date, importance, snippet, status, reason, url: page.url };\n});\nreturn [{ json: { action: 'list', count: emails.length, emails } }];"
      },
