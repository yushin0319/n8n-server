    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst importance = input.importance || '確認';\nconst filterObj = { property: '重要度', select: { equals: importance } };\nif (importance === '重要') {\n  const compoundFilter = {\n    and: [\n      { property: '重要度', select: { equals: '重要' } },\n      { property: 'ステータス', select: { equals: '未読' } }\n    ]\n  };\n  return [{ json: { queryBody: JSON.stringify({ filter: compoundFilter, sorts: [{ property: '日時', direction: 'descending' }] }) } }];\n}\nreturn [{ json: { queryBody: JSON.stringify({ filter: filterObj, sorts: [{ property: '日時', direction: 'descending' }] }) } }];"
      },
