        "notionApi": {
          "id": "StdChbKZz3co4jDO",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first().json.results || [];\nconst importantEmails = [];\nconst unclassifiedEmails = [];\nconst allPageIds = [];\nfor (const page of results) {\n  const subject = (page.properties['件名']?.title || []).map(t => t.plain_text).join('') || '(無題)';\n  const from = (page.properties['差出人']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  const date = page.properties['日時']?.date?.start || '';\n  const importance = page.properties['重要度']?.select?.name || '未設定';\n  const snippet = (page.properties['スニペット']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  const reason = (page.properties['理由']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  const emailData = { id: page.id, subject, from, date, importance, snippet, reason, url: page.url };\n  if (importance === '重要') {\n    importantEmails.push(emailData);\n  } else if (importance === '確認') {\n    unclassifiedEmails.push(emailData);\n  }\n  allPageIds.push(page.id);\n}\nconst briefingResponse = { action: 'briefing', important: { count: importantEmails.length, emails: importantEmails }, unclassified: { count: unclassifiedEmails.length, emails: unclassifiedEmails }, marked_read_count: allPageIds.length };\nreturn [{ json: { briefingResponse, allPageIds } }];"
      },
