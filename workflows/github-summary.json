{
  "name": "GitHub 日次活動サマリー",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 14
            }
          ]
        }
      },
      "id": "6e543788-004b-4720-945b-9fdd0df41516",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/users/yushin0319/events?per_page=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GITHUB_PAT"
            },
            {
              "name": "User-Agent",
              "value": "n8n-github-summary"
            }
          ]
        },
        "options": {}
      },
      "id": "6294d275-93a2-4512-a766-247c4996f29e",
      "name": "FetchEvents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const events = $input.all().map(i => i.json);\n\n// JST (UTC+9) で今日の日付を算出\nconst jstOffset = 9 * 60 * 60 * 1000;\nconst jstNow = new Date(Date.now() + jstOffset);\nconst todayStr = jstNow.toISOString().substring(0, 10);\n\n// 今日のイベントのみフィルタ\nconst todayEvents = events.filter(e => {\n  const d = new Date(new Date(e.created_at).getTime() + jstOffset);\n  return d.toISOString().substring(0, 10) === todayStr;\n});\n\n// PushEvent のコミットをリポジトリ別にグループ化\nconst repos = {};\nlet totalCommits = 0;\n\nfor (const ev of todayEvents) {\n  if (ev.type === 'PushEvent' && ev.payload && ev.payload.commits) {\n    const repoName = ev.repo.name;\n    if (!repos[repoName]) repos[repoName] = [];\n    for (const c of ev.payload.commits) {\n      repos[repoName].push(c.message.split('\\n')[0]);\n      totalCommits++;\n    }\n  }\n}\n\nconst title = `GitHub活動 ${todayStr}`;\nconst children = [];\n\nfor (const [repo, commits] of Object.entries(repos)) {\n  children.push({\n    object: 'block',\n    type: 'heading_3',\n    heading_3: { rich_text: [{ type: 'text', text: { content: repo } }] }\n  });\n  for (const msg of commits) {\n    children.push({\n      object: 'block',\n      type: 'bulleted_list_item',\n      bulleted_list_item: { rich_text: [{ type: 'text', text: { content: msg.substring(0, 2000) } }] }\n    });\n  }\n}\n\nconst requestBody = {\n  parent: { database_id: '2a02570f-e49f-802b-a67c-fe4c230a5699' },\n  properties: {\n    '': { title: [{ text: { content: title } }] },\n    'ステータス': { status: { name: '完了' } }\n  },\n  children\n};\n\nreturn [{ json: { requestBody: JSON.stringify(requestBody), totalCommits, title } }];",
        "options": {}
      },
      "id": "d9da51cd-97c4-4013-bfef-ce07972fe499",
      "name": "FormatSummary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "d0f03cc6-6f01-4ac6-a149-667e20a4530c",
              "leftValue": "={{ $json.totalCommits }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "98d52354-4933-40ad-9454-0626bdafa311",
      "name": "IfHasActivity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}"
      },
      "id": "9b25193c-5051-43b4-81b7-41be986f7831",
      "name": "CreatePage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "notionApi": {
          "id": "StdChbKZz3co4jDO",
          "name": "Notion account"
        }
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
