{
  "id": "BG2MtyVnocJvwz2f",
  "name": "GitHub 日次活動サマリー",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 23,
              "triggerAtMinute": 50
            }
          ]
        }
      },
      "id": "48f2bb3b-1a2c-44ad-8969-afbc24b45af4",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/commits?q=author:yushin0319+committer-date:{{ $now.setZone('Asia/Tokyo').toISODate() }}&per_page=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REDACTED_GITHUB_PAT"
            },
            {
              "name": "User-Agent",
              "value": "n8n-github-summary"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {}
      },
      "id": "066765e5-a3c3-4ba4-a522-6f86e802a831",
      "name": "FetchCommits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst commits = result.items || [];\n\n// リポジトリ別にグループ化\nconst repos = {};\nlet totalCommits = commits.length;\n\nfor (const item of commits) {\n  const repoName = item.repository.full_name;\n  if (!repos[repoName]) repos[repoName] = [];\n  const msg = item.commit.message.split('\\n')[0];\n  repos[repoName].push(msg);\n}\n\n// JST date for title\nconst jstOffset = 9 * 60 * 60 * 1000;\nconst jstNow = new Date(Date.now() + jstOffset);\nconst todayStr = jstNow.toISOString().substring(0, 10);\nconst title = `GitHub\\u6d3b\\u52d5 ${todayStr}`;\n\nconst children = [];\n\nfor (const [repo, messages] of Object.entries(repos)) {\n  children.push({\n    object: 'block',\n    type: 'heading_3',\n    heading_3: { rich_text: [{ type: 'text', text: { content: repo } }] }\n  });\n  for (const msg of messages) {\n    children.push({\n      object: 'block',\n      type: 'bulleted_list_item',\n      bulleted_list_item: { rich_text: [{ type: 'text', text: { content: msg.substring(0, 2000) } }] }\n    });\n  }\n}\n\nconst requestBody = {\n  parent: { database_id: '2a02570f-e49f-802b-a67c-fe4c230a5699' },\n  properties: {\n    '': { title: [{ text: { content: title } }] },\n    '\\u30b9\\u30c6\\u30fc\\u30bf\\u30b9': { status: { name: '\\u5b8c\\u4e86' } }\n  },\n  children\n};\n\nreturn [{ json: { requestBody: JSON.stringify(requestBody), totalCommits, title } }];",
        "options": {}
      },
      "id": "266da002-6b1b-4902-b420-fb7420057e89",
      "name": "FormatSummary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "83c37e60-269e-4766-b914-a95cc0a95d27",
              "leftValue": "={{ $json.totalCommits }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1eda3a5-749e-4325-923b-84d39a24b8ff",
      "name": "IfHasActivity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}"
      },
      "id": "c6336627-6fb3-44f6-bcc3-970fbdd6c9dc",
      "name": "CreatePage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "notionApi": {
          "id": "StdChbKZz3co4jDO",
          "name": "Notion account"
        }
      }
    }
  ],
  "connections": {
