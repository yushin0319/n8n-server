        "url": "https://api.notion.com/v1/databases/2ff2570f-e49f-817d-8288-e7c8667641a9/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"filter\": {\"property\": \"\\u65e2\\u8aad\", \"checkbox\": {\"equals\": false}}, \"sorts\": [{\"property\": \"\\u65e5\\u4ed8\", \"direction\": \"descending\"}]}"
      },
      "id": "nn-list-query",
      "name": "ListQuery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        100
      ],
      "credentials": {
        "notionApi": {
          "id": "StdChbKZz3co4jDO",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = $input.first().json.results || [];\nconst news = results.map(page => {\n  const title = (page.properties['タイトル']?.title || []).map(t => t.plain_text).join('') || '(無題)';\n  const url = page.properties['URL']?.url || '';\n  const category = page.properties['カテゴリ']?.select?.name || '';\n  const source = (page.properties['ソース']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  const date = page.properties['日付']?.date?.start || '';\n  const summary = (page.properties['要約']?.rich_text || []).map(t => t.plain_text).join('') || '';\n  const read = page.properties['既読']?.checkbox || false;\n  const featured = page.properties['注目']?.checkbox || false;\n  return { id: page.id, title, url, category, source, date, summary, read, featured };\n});\nreturn [{ json: { action: 'list', count: news.length, news } }];"
      },
      "id": "nn-format-list",
      "name": "FormatList",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "nn-respond-list",
      "name": "RespondList",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1000,
        100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst pageId = input.page_id;\nif (!pageId) throw new Error('page_id is required');\nconst body = { properties: {} };\nif (input.read !== undefined) {\n  body.properties['既読'] = { checkbox: !!input.read };\n}\nif (input.featured !== undefined) {\n  body.properties['注目'] = { checkbox: !!input.featured };\n}\nif (input.category !== undefined) {\n  body.properties['カテゴリ'] = { select: { name: input.category } };\n}\nreturn [{ json: { pageId, requestBody: JSON.stringify(body) } }];"
      },
      "id": "nn-prep-update",
      "name": "PrepUpdate",
      "type": "n8n-nodes-base.code",
