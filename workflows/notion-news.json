      "id": "nn-respond-update",
      "name": "RespondUpdate",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst items = input.items || [];\nif (!items.length) throw new Error('items array is required');\nconst results = [];\nfor (const item of items) {\n  const pageId = item.page_id;\n  if (!pageId) continue;\n  const body = { properties: {} };\n  if (item.read !== undefined) {\n    body.properties['既読'] = { checkbox: !!item.read };\n  }\n  if (item.featured !== undefined) {\n    body.properties['注目'] = { checkbox: !!item.featured };\n  }\n  if (item.category !== undefined) {\n    body.properties['カテゴリ'] = { select: { name: item.category } };\n  }\n  results.push({ json: { pageId, requestBody: JSON.stringify(body) } });\n}\nreturn results;"
      },
