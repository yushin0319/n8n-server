    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst filters = [];\nif (input.source) {\n  filters.push({ property: 'ソース', rich_text: { contains: input.source } });\n}\nif (input.category) {\n  filters.push({ property: 'カテゴリ', select: { equals: input.category } });\n}\nif (input.query) {\n  filters.push({ property: 'タイトル', title: { contains: input.query } });\n}\nif (input.featured !== undefined) {\n  filters.push({ property: '注目', checkbox: { equals: !!input.featured } });\n}\nif (input.read !== undefined) {\n  filters.push({ property: '既読', checkbox: { equals: !!input.read } });\n}\nif (input.date_from) {\n  filters.push({ property: '日付', date: { on_or_after: input.date_from } });\n}\nif (input.date_to) {\n  filters.push({ property: '日付', date: { on_or_before: input.date_to } });\n}\nconst body = {};\nif (filters.length > 0) {\n  body.filter = filters.length === 1 ? filters[0] : { and: filters };\n}\nbody.sorts = [{ property: '日付', direction: 'descending' }];\nif (input.limit) {\n  body.page_size = Math.min(input.limit, 100);\n}\nreturn [{ json: { requestBody: JSON.stringify(body) } }];"
      },
