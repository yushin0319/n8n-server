      "name": "Webhook",
      "webhookId": "3fca1ef9-23c2-4cc4-acb0-13126c09ef56"
    },
    {
      "parameters": {
        "jsCode": "// [共通パターン] Webhook認証チェック - 全n8nワークフロー共通\n// WEBHOOK_SECRET 環境変数で認証キーを管理（n8n設定 > Environment Variables）\nconst secret = $input.first().json.headers['x-webhook-secret'];\nif (secret !== $env.WEBHOOK_SECRET) {\n  throw new Error('Forbidden: Invalid webhook secret');\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "fe60504d-b358-466b-b037-57d530d3b90c",
      "name": "AuthCheck"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst fileId = body.file_id;\nif (!fileId) throw new Error('file_id is required');\nreturn [{ json: { fileId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "18a20577-e542-4282-9625-7d1704bae4d2",
      "name": "PrepDownload"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.fileId }}?alt=media",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        0
      ],
      "id": "34c81017-9e73-46f3-955b-e6756d904397",
      "name": "DownloadRequest",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "PLACEHOLDER",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// n8n wraps raw text response in { data: \"...\" }\nconst raw = $json;\nlet content;\nif (raw.data !== undefined) {\n  content = raw.data;\n} else if (typeof raw === 'string') {\n  content = raw;\n} else {\n  content = JSON.stringify(raw);\n}\nconst fileId = $('PrepDownload').first().json.fileId;\nreturn [{ json: { action: 'download', file_id: fileId, content } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
